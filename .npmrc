# @auth/core (via next-auth) déclare un pair optionnel sur une vieille version
# de @simplewebauthn — le fournisseur passkey intégré d'Auth.js, que ce projet
# n'utilise pas (voir la note dans lib/agence/auth.ts : la cérémonie WebAuthn
# est pilotée à la main, avec la version actuelle de la bibliothèque). Sans
# cette ligne, l'installation stricte de Vercel refuse de démarrer sur ce
# conflit alors qu'il ne touche aucun code réellement exécuté.
legacy-peer-deps=true
